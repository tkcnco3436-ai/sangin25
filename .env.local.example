# 기업마당(bizinfo.go.kr)에서 발급받은 지원사업정보 API 인증키를 = 뒤에 붙여 넣으세요.
BIZINFO_API_KEY=

# 포트폴리오 AI 문장 다듬기 + 계획서 도우미(배포)용 Anthropic API 키 (console.anthropic.com에서 발급)
# 서버 환경변수로만 씁니다. 브라우저로 나가지 않습니다. NEXT_PUBLIC_ 접두어를 붙이지 마세요.
ANTHROPIC_API_KEY=

# ── 계획서 도우미 (/plan-helper) ──
# AI 연결 방식
#   claude-code : 이 컴퓨터에 로그인된 Claude Code CLI(`claude -p`) 사용. API 키 불필요. 로컬 개발·테스트 전용.
#   anthropic   : Anthropic Messages API (ANTHROPIC_API_KEY 필요). 배포 환경은 반드시 이것.
# 비워 두면 `npm run dev`는 claude-code, 그 밖(next start, Vercel)은 anthropic.
AI_PROVIDER=

# 사용할 Claude 모델 (기본 claude-opus-5-5)
PLAN_HELPER_MODEL=

# 업로드 한도(MB, 기본 20). Vercel 서버리스 함수는 요청 본문이 4.5MB로 제한되니 배포 전 docs/plan-helper 참고.
PLAN_HELPER_MAX_UPLOAD_MB=
NEXT_PUBLIC_PLAN_HELPER_MAX_UPLOAD_MB=

# claude-code 전용 (선택): claude 실행 파일 경로, 응답 제한 시간(ms, 기본 240000)
CLAUDE_CLI_PATH=
CLAUDE_CLI_TIMEOUT_MS=
